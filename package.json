{
  "name": "zk-sync-agent",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron dist/main.js",
    "dev": "tsc -w & electron dist/main.js",
    "build:ts": "tsc && mkdir -p dist/ui && cp src/ui/index.html dist/ui/index.html",
    "build:win": "npm run build:ts && electron-builder --win",
    "build:linux": "npm run build:ts && electron-builder --linux"
  },
  "dependencies": {
    "electron-log": "^5.0.0",
    "node-zk-ahris": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.3.0"
  },
  "build": {
    "appId": "com.mayhomes.zk-sync-agent",
    "productName": "ZK Sync Agent",
    "files": [
      "dist/**",
      "config.json",
      "assets/**",
      "src/ui/index.html"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
